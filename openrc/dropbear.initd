#!/sbin/openrc-run
# OpenRC init script for Dropbear SSH Server (v2019.78)
# Designed for Alpine Linux VPN Tunneling Stack

name="dropbear"
description="Dropbear SSH Server (v2019.78)"
rc_ulimit="-n 65535"
pidfile="/run/dropbear.pid"
command="/usr/sbin/dropbear"
command_args="${DROPBEAR_OPTS:--R -b /etc/alpinessh/issue.net -p 109 -p 143 -P /run/dropbear.pid}"

depend() {
    need net
    provide ssh-server
}

start_pre() {
    mkdir -p /etc/dropbear /etc/alpinessh /run
    [ ! -f /etc/dropbear/dropbear_ed25519_host_key ] && /usr/bin/dropbearkey -t ed25519 -f /etc/dropbear/dropbear_ed25519_host_key >/dev/null 2>&1 || true
    [ ! -f /etc/dropbear/dropbear_rsa_host_key ] && /usr/bin/dropbearkey -t rsa -s 2048 -f /etc/dropbear/dropbear_rsa_host_key >/dev/null 2>&1 || true
    [ ! -f /etc/dropbear/dropbear_ecdsa_host_key ] && /usr/bin/dropbearkey -t ecdsa -f /etc/dropbear/dropbear_ecdsa_host_key >/dev/null 2>&1 || true
    chmod 600 /etc/dropbear/* 2>/dev/null || true
    ulimit -n 65535 2>/dev/null || true
}
